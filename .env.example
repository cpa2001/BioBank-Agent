# Biobank Agent Configuration
# Copy this to .env and fill in your values

# === LLM API ===
LLM_BASE_URL=http://api.shubiaobiao.cn
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-6

# === Data Paths ===
# Processed parquet (fast path, 406 MB)
UKB_PARQUET_DIR=/Users/chenpengan/Projects/CUHK/milton_data
# Raw CSVs (comprehensive, ~149 GB)
UKB_RAW_DIR=/Users/chenpengan/Projects/CUHK/UKB

# === Optional ===
# Reports output directory (default: ./reports/)
# REPORTS_DIR=./reports
# Long-term memory path (default: ~/.biobank_agent/memory.json)
# MEMORY_DIR=~/.biobank_agent
