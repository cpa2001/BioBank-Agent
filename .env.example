# Biobank Agent Configuration
# Copy this to .env and fill in your values

# === LLM API ===
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek/deepseek-v4-pro

# === Multi-Agent Routing (Optional but recommended) ===
MULTI_MODEL_ENABLED=true
AUTO_DISCOVER_MODELS=true
PREFERRED_MULTI_MODELS=deepseek/deepseek-v4-pro,moonshotai/kimi-k2.6,z-ai/glm-5.1
# MODEL_POOL=deepseek/deepseek-v4-pro,moonshotai/kimi-k2.6,z-ai/glm-5.1   # optional manual override

# === Data Paths ===
DATA_DIR=./data                     # Parquet files (fast path)
RAW_DIR=./raw                       # Raw CSV fallback (optional)

# === Biobank Identity ===
# Override these for non-UKB biobanks
# BIOBANK_NAME=UK Biobank
# BIOBANK_ABBREVIATION=UKB
# SUBJECT_ID_COL=eid
# DIAGNOSES_CODE_COL=diag_icd10
# DEATHS_CODE_COL=cause_icd10

# === Web Search (Optional) ===
# Default: DuckDuckGo (no key needed)
# SEARCH_PROVIDER=duckduckgo
# SEARCH_API_KEY=your-brave-or-serper-key

# === Optional Paths ===
# REPORTS_DIR=./reports
# MEMORY_DIR=~/.biobank_agent
# PLANS_DIR=./plans
# CUSTOM_SKILLS_DIR=./custom_skills
