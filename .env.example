# Biobank Agent Configuration
# Copy this to .env and fill in your values

# === LLM API ===
LLM_BASE_URL=http://api.shubiaobiao.cn
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-6

# === Data Paths ===
# Processed parquet (fast path)
UKB_PARQUET_DIR=./milton_data
# Raw CSVs (comprehensive, ~149 GB)
UKB_RAW_DIR=./UKB

# === Web Search (Optional) ===
# Default: DuckDuckGo (no key needed)
# Options: 'duckduckgo', 'brave', 'serper'
# SEARCH_PROVIDER=duckduckgo
# SEARCH_API_KEY=your-brave-or-serper-key

# === Optional ===
# Reports output directory (default: ./reports/)
# REPORTS_DIR=./reports
# Long-term memory path (default: ~/.biobank_agent/memory.json)
# MEMORY_DIR=~/.biobank_agent
# Plan files directory (default: ./plans/)
# PLANS_DIR=./plans
# Custom skills directory (default: ./custom_skills/)
# CUSTOM_SKILLS_DIR=./custom_skills
